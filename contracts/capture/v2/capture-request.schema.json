{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:poppincn:popup:capture-request:v2",
    "title": "CaptureRequest v2",
    "type": "object",
    "additionalProperties": false,
    "required": ["contract_version", "video_urls", "account_name", "sequence_start"],
    "properties": {
        "contract_version": { "const": "popup.capture.request.v2" },
        "video_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^https://(?![^/?#]*@).+" }
        },
        "account_name": { "type": "string", "pattern": "\\S" },
        "sequence_start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740989,
            "description": "Original one-based sequence for the first URL; subsequent URLs must be consecutive."
        }
    }
}
