{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:poppincn:popup:capture-request:v1",
    "title": "CaptureRequest v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["contract_version", "video_urls"],
    "properties": {
        "contract_version": { "const": "popup.capture.request.v1" },
        "video_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^https://(?![^/?#]*@).+" }
        }
    }
}
